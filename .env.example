# ============================================================================
# Predictive Supplier Risk Intelligence — Environment Configuration Example
# Copy this file to .env (project root or backend/) and adjust as needed.
# Every variable is optional; the app runs fully offline with these defaults.
# ============================================================================

APP_ENV=development
DEBUG=false

# Database: defaults to a local SQLite file at backend/data/supplier_risk.db.
# For multiuser production, use PostgreSQL (the psycopg v3 driver is bundled).
# DATABASE_URL=sqlite:///./data/supplier_risk.db
# DATABASE_URL=postgresql+psycopg://sri_user:sri_password@localhost:5432/supplier_risk

# JWT Authentication Secret (override with a strong random value in production!)
JWT_SECRET_KEY=replace-with-strong-random-32-byte-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Authentication mode -----------------------------------------------------
# ALLOW_DEMO_MODE=true enables X-Demo-Role/X-Demo-User headers and the login
# page's one-click demo accounts. Set to false for any shared deployment: the
# API then requires a valid JWT on every /api/* request.
ALLOW_DEMO_MODE=true
# Auto-seed the reproducible synthetic dataset on first startup (idempotent)
SEED_DEMO_DATA=true
# Auto-train the champion model on startup if no verified artifact exists
AUTO_TRAIN_ON_STARTUP=true

# Override storage locations (useful for containers / isolated tests)
# ARTIFACTS_DIR=./artifacts
# DATA_DIR=./data

# Reproducibility & Reference Date (point-in-time evaluation wall clock)
RANDOM_SEED=42
REFERENCE_DATE=2026-10-17

# Risk & Reviewer Capacity Defaults
MODERATE_RISK_THRESHOLD=0.35
HIGH_RISK_THRESHOLD=0.60
CRITICAL_RISK_THRESHOLD=0.80
DEFAULT_REVIEWER_CAPACITY=25

# --- Optional AI / LLM Intelligence Layer ------------------------------------
# Default: "none" — a free, deterministic, offline fact-grounded synthesizer.
# Supported: none | openai | anthropic | openrouter | ollama | custom
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=offline-deterministic-v1
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_MAX_TOKENS=600
AI_BUDGET_LIMIT_USD=10.0
# Dedicated Fernet key for encrypting provider API keys at rest.
# Falls back to JWT_SECRET_KEY when empty. Rotate to invalidate stored secrets.
AI_ENCRYPTION_KEY=

# CORS Allowed Origins (comma-separated). Restrict this in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------------------------
# Local AI example (Ollama, if installed): start `ollama serve` and pull a model,
# then set AI_PROVIDER=ollama, AI_BASE_URL=http://localhost:11434/v1 and a model
# such as AI_MODEL=gemma3:latest. No API key is required for local inference.
# ----------------------------------------------------------------------------
